# --- App Environment ---
# Options: development, production
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=your_database_url_here

# --- LLM API Keys ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Security ---
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256

# --- JWT Configuration ---
# Masa berlaku token dalam menit (Default: 30 menit)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database Seeding Passwords ---
# NOTE: In 'production' mode, these passwords MUST be set in your .env file.
# If left empty in 'development' mode, they will fall back to defaults (UbakAdmin123, etc.)
DEFAULT_ADMIN_PASSWORD=UbakAdmin123
DEFAULT_VIP_PASSWORD=UbakVip123
DEFAULT_FREE_PASSWORD=UbakFree123
